---
import { existsSync } from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';

// Drop a photo at public/hero.jpg (or .webp / .jpeg / .png) and it takes over
// the landing page. Until then the drawn scene stands in, so there is never a
// grey box waiting on an asset.
//
// Resolved against the working directory, not import.meta.url: Astro rewrites
// module URLs during the build, so the relative form silently never matches.
const HERO_CANDIDATES = ['hero.webp', 'hero.jpg', 'hero.jpeg', 'hero.png'];
const heroFile = HERO_CANDIDATES.find((f) =>
  existsSync(path.join(process.cwd(), 'public', f))
);
const heroPhoto = heroFile ? '/' + heroFile : null;

const sections = (await getCollection('sections')).sort(
  (a, b) => a.data.order - b.data.order
);

// Render every section's Markdown up front; the page is fully static.
const rendered = await Promise.all(
  sections.map(async (entry) => ({ entry, ...(await render(entry)) }))
);

const hoods = (await getCollection('neighborhoods')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);

// The point of the picker is that somebody who has just moved here gets an
// answer before they have to read anything. Curated lists only -- the personal
// ones are a record of where somebody went, not an answer to "where do I run".
const picks = (await getCollection('lists'))
  .filter((l) => l.data.curated && !l.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);

const elsewhere = (await import('../data/from-elsewhere.json')).default;

const pad = (n: number) => String(n).padStart(2, '0');
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<Base
  title="A local’s guide to Seattle — seattlerec.com"
  description="An intro to Seattle as a city: how to orient yourself, how to get around, the Freeze, the rain myth, and the quirks nobody tells a first-time visitor."
>
  <header class="hero hero-photo">
    <div class="hero-media">
      {heroPhoto
        ? <img src={heroPhoto} alt="The Olympic Mountains across Puget Sound, with a Washington State ferry crossing" fetchpriority="high" />
        : <HeroScene />}
    </div>
    <div class="hero-scrim"></div>

    <div class="wrap hero-content">
      <p class="eyebrow">An intro to the city</p>
      <h1>A local’s guide to <em>Seattle</em></h1>
      <p class="lede">
        Everything a first-time visitor needs before the rest of it makes sense —
        how the place is shaped, how to move through it, what closes early, and
        which of the things you have heard are actually true.
      </p>
      <p class="hero-cta">
        <a href="/lists/">Skip to the lists →</a>
      </p>
    </div>
  </header>

  <section class="picker" id="what-are-you-after">
    <div class="wrap-wide">
      <h2 class="picker-q">What are you after?</h2>
      <p class="picker-sub">
        Pick one and you get a map and a shortlist. No account, no quiz.
      </p>
      <div class="picker-grid">
        {picks.map((l) => (
          <a class="pick" href={`/lists/${l.data.slug}/`}>
            <span class="pick-emoji" aria-hidden="true">{l.data.emoji}</span>
            <span class="pick-name">{l.data.name}</span>
            {l.data.blurb && <span class="pick-why">{l.data.blurb}</span>}
            <span class="pick-count">{l.data.places.length} {l.data.places.length === 1 ? 'place' : 'places'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="elsewhere" id="from-elsewhere">
    <div class="wrap-wide">
      <div class="section-head">
        <p class="kicker">You already know what you like</p>
        <h2>Coming from somewhere else</h2>
      </div>
      <p class="elsewhere-lede">
        Nobody moves to a city wanting <em>a city</em>. You want the specific
        thing you used to do on a Thursday. Here is where that thing lives now.
      </p>

      <div class="swap-grid">
        {elsewhere.map((place) => (
          <div class="swap-city">
            <h3>{place.city}</h3>
            {place.swaps.map((s) => (
              <a class="swap" href={s.href}>
                <span class="swap-from">{s.from}</span>
                <span class="swap-arrow" aria-hidden="true">↓</span>
                <span class="swap-to">{s.to}</span>
                <span class="swap-why">{s.why}</span>
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <nav class="contents">
    <div class="wrap">
      <h2>Contents</h2>
      <ol class="toc">
        {sections.map((s) => (
          <li>
            <a href={`#${slug(s.data.title)}`}>
              <span class="n">{pad(s.data.order)}</span>
              <span class="t">
                {s.data.title}
                <span class="s">{s.data.summary}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <main>
    {rendered.map(({ entry, Content }) => (
      <section class="section" id={slug(entry.data.title)}>
        <div class="wrap">
          <div class="section-head">
            <span class="num">{pad(entry.data.order)}</span>
            <p class="kicker">{entry.data.kicker}</p>
            <h2>{entry.data.title}</h2>
          </div>
          <div class="prose">
            <Content />
          </div>
        </div>
      </section>
    ))}

    <section class="hoods" id="neighborhoods">
      <div class="wrap-wide">
        <div class="section-head">
          <p class="kicker">Where to point yourself</p>
          <h2>The neighborhoods</h2>
        </div>
        <div class="hood-grid">
          {hoods.map((h) => (
            <article class="hood">
              <h3>{h.data.name}</h3>
              <ul class="tags">
                {h.data.vibe.map((v) => <li>{v}</li>)}
              </ul>
              <p class="one">{h.data.oneLine}</p>
              <p class="transit">{h.data.transit}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <p class="big">Next: <a href="/lists/">the actual recommendations</a>.</p>
      <p>
        Every list on a map, with the reasons attached — and a search across all
        of them when you already know the word you are looking for.
      </p>
    </div>
  </footer>
</Base>
