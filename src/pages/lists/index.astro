---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const lists = (await getCollection('lists'))
  .filter((l) => !l.data.hidden)
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));

// Two different promises, so they do not sit in one undifferentiated grid.
// The curated lists answer a question; the personal ones are a record of where
// somebody actually went, which is a different and more fallible thing.
const groups = [
  {
    key: 'curated',
    title: 'Start here',
    sub: 'Answers to the question you actually have.',
    lists: lists.filter((l) => l.data.curated),
  },
  {
    key: 'personal',
    title: 'From my own maps',
    sub: 'Saved and reviewed over a few years of living here. Honest, not comprehensive.',
    lists: lists.filter((l) => !l.data.curated),
  },
].filter((g) => g.lists.length > 0);

// Each tile carries a little constellation of its own pins: the list's places
// normalised into the tile's box, so a tightly clustered list reads as tight
// and a list spread across the city reads as spread. It is a real preview of
// the map, drawn from the same coordinates, with nothing to load.
function constellation(places: { lat: number; lng: number }[]) {
  const lats = places.map((p) => p.lat);
  const lngs = places.map((p) => p.lng);
  const minLat = Math.min(...lats), maxLat = Math.max(...lats);
  const minLng = Math.min(...lngs), maxLng = Math.max(...lngs);

  // A single point, or a perfectly straight line of them, would divide by zero.
  const spanLat = Math.max(maxLat - minLat, 0.004);
  const spanLng = Math.max(maxLng - minLng, 0.004);
  const pad = 12;
  const box = 100 - pad * 2;

  return places.map((p) => ({
    x: pad + ((p.lng - (minLng + maxLng) / 2) / spanLng + 0.5) * box,
    y: pad + (0.5 - (p.lat - (minLat + maxLat) / 2) / spanLat) * box, // north is up
  }));
}

const totalPlaces = lists.reduce((n, l) => n + l.data.places.length, 0);

// Flat index of every place in every list, shipped inline so search is instant
// and works offline. Keys are one letter because this is repeated once per
// place and nothing else reads it: n(ame), l(ist), s(lug), i(ndex), k(inds).
const searchIndex = lists.flatMap((l) =>
  l.data.places.map((p, i) => ({
    n: p.name,
    l: l.data.name,
    s: l.data.slug,
    i,
    k: (p.kinds ?? []).join(' '),
  }))
);
---

<Base
  title="The lists — seattlerec.com"
  description="Saved Seattle places, grouped the way you would actually use them: coffee, date night, outdoors, rainy days. Every list opens onto a map."
>
  <header class="hero hero-sm">
    <div class="wrap-wide">
      <p class="eyebrow"><a href="/">A local’s guide to Seattle</a> &nbsp;/&nbsp; the lists</p>
      <h1>The <em>lists</em></h1>
      <p class="lede">
        {totalPlaces} places across {lists.length} lists. Open one and you get
        the map and the reasons together.
      </p>
    </div>
  </header>

  <div class="wrap-wide">
    <form class="search" role="search" onsubmit="return false">
      <label class="sr-only" for="q">Search every place</label>
      <input
        type="search"
        id="q"
        autocomplete="off"
        spellcheck="false"
        placeholder={`Search ${totalPlaces} places — ramen, park, Ballard…`}
      />
      <p class="search-hint" id="searchHint" aria-live="polite"></p>
    </form>
  </div>

  <div class="wrap-wide">
    <section class="results" id="results" hidden>
      <ol class="hits" id="hits"></ol>
      <p class="no-hits" id="noHits" hidden>Nothing matches. Try a shorter word.</p>
    </section>
  </div>

  <main class="board-wrap" id="board">
    <div class="wrap-wide">
      {groups.map((g) => (
        <section class:list={['board-group', { compact: g.key === 'personal' && g.lists.length > 8 }]}>
          <div class="section-head">
            <h2>{g.title}</h2>
            <p class="kicker">{g.sub}</p>
          </div>
          <div class="board">
            {g.lists.map((l) => {
              const pts = constellation(l.data.places);
              const preview = l.data.places.slice(0, 3).map((p) => p.name);
              const more = l.data.places.length - preview.length;
              return (
                <a class="tile" href={`/lists/${l.data.slug}/`} data-name={l.data.name.toLowerCase()}>
                  <svg class="tile-map" viewBox="0 0 100 100" aria-hidden="true" preserveAspectRatio="none">
                    {pts.map((pt) => <circle cx={pt.x} cy={pt.y} r="2.6" />)}
                  </svg>
                  <div class="tile-body">
                    <span class="tile-emoji" aria-hidden="true">{l.data.emoji ?? '📍'}</span>
                    <h2>{l.data.name}</h2>
                    {l.data.blurb && <p class="tile-blurb">{l.data.blurb}</p>}
                    <p class="tile-preview">
                      {preview.join(' · ')}{more > 0 && <span class="more"> · +{more} more</span>}
                    </p>
                  </div>
                  <div class="tile-foot">
                    <span class="count">{l.data.places.length} places</span>
                    <span class="go" aria-hidden="true">Open map →</span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </main>

  <footer class="site-foot">
    <div class="wrap">
      <p class="big">New to the city?</p>
      <p>
        Start with <a href="/">the guide</a> — how the place is shaped, how to move
        through it, and which of the things you have heard are actually true.
      </p>
    </div>
  </footer>

  <script type="application/json" id="index" set:html={JSON.stringify(searchIndex)}></script>

  <script>
    const input = document.getElementById('q');
    const board = document.getElementById('board');
    const results = document.getElementById('results');
    const hits = document.getElementById('hits');
    const noHits = document.getElementById('noHits');
    const hint = document.getElementById('searchHint');
    const raw = document.getElementById('index')?.textContent;

    if (input && raw) {
      const index = JSON.parse(raw);
      const tiles = Array.from(document.querySelectorAll('.tile'));
      const MAX = 60;

      const norm = (s) =>
        s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');

      // Precompute once. 500+ places is nothing to filter, but normalising on
      // every keystroke is wasted work either way.
      const haystack = index.map((r) => norm(r.n + ' ' + r.l + ' ' + r.k));

      const esc = (s) =>
        s.replace(/[&<>"']/g, (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]
        );

      // Wrap the matched run so the eye lands on why a row came back.
      function mark(text, needle) {
        const at = norm(text).indexOf(needle);
        if (at < 0) return esc(text);
        return (
          esc(text.slice(0, at)) +
          '<mark>' + esc(text.slice(at, at + needle.length)) + '</mark>' +
          esc(text.slice(at + needle.length))
        );
      }

      function run() {
        const q = norm(input.value.trim());

        if (!q) {
          board.hidden = false;
          results.hidden = true;
          hint.textContent = '';
          tiles.forEach((t) => (t.hidden = false));
          return;
        }

        // Lists whose own name matches stay visible as tiles above the places.
        let listMatches = 0;
        tiles.forEach((t) => {
          const hit = norm(t.dataset.name || '').includes(q);
          t.hidden = !hit;
          if (hit) listMatches++;
        });

        const matched = [];
        for (let i = 0; i < haystack.length && matched.length < MAX; i++) {
          if (haystack[i].includes(q)) matched.push(index[i]);
        }
        const totalMatched = haystack.filter((h) => h.includes(q)).length;

        board.hidden = listMatches === 0;
        results.hidden = false;
        noHits.hidden = totalMatched > 0 || listMatches > 0;

        hits.innerHTML = matched
          .map(
            (r) =>
              '<li class="hit"><a href="/lists/' + encodeURIComponent(r.s) + '/#place-' + r.i + '">' +
              '<span class="hit-name">' + mark(r.n, q) + '</span>' +
              '<span class="hit-list">' + mark(r.l, q) + '</span>' +
              '</a></li>'
          )
          .join('');

        const shown = Math.min(totalMatched, MAX);
        hint.textContent =
          totalMatched === 0
            ? (listMatches ? listMatches + ' list' + (listMatches === 1 ? '' : 's') : '')
            : shown + ' of ' + totalMatched + ' place' + (totalMatched === 1 ? '' : 's') +
              (listMatches ? ' · ' + listMatches + ' list' + (listMatches === 1 ? '' : 's') : '');
      }

      input.addEventListener('input', run);
      input.addEventListener('search', run);

      // Deep link: /lists/?q=ramen
      const preset = new URLSearchParams(location.search).get('q');
      if (preset) { input.value = preset; run(); }
    }
  </script>
</Base>
